# Copy to `state/secrets.env` and fill in. The kernel loads these into ITS OWN
# environment only; they are stripped from app subprocess environments, so the
# mutable app never sees provider keys. LiteLLM reads these by convention.
#
# DEEPSEEK_API_KEY=sk-...     # <- default model is deepseek/deepseek-v4-flash
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
